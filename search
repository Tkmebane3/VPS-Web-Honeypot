<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TradeMaster Pro Search</title>
    <style>
        body {
            background: #0f172a;
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .search-box {
            width: 420px;
            background: #1e293b;
            padding: 30px;
            border-radius: 10px;
        }

        input, button {
            box-sizing: border-box;
            width: 100%;
            padding: 12px;
            margin-top: 12px;
            border: 0;
            border-radius: 5px;
        }

        button {
            background: #22c55e;
            color: white;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="search-box">
        <h2>Search Trading Resources</h2>

        <form action="/api/search" method="GET">
            <input
                type="text"
                name="q"
                placeholder="Search reports, symbols, or resources"
                autocomplete="off"
                required
            >

            <button type="submit">Search</button>
        </form>
    </div>
</body>
</html>